{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AxiomaGoNouns",
  "definitions": {
    "IntersectionCoord": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 9 },
        "y": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    },
    "StoneColor": {
      "type": "string",
      "enum": ["BLACK", "WHITE", "EMPTY"]
    },
    "StoneGroup": {
      "type": "object",
      "required": ["group_id", "color", "stones", "liberties"],
      "properties": {
        "group_id": { "type": "string" },
        "color": { "$ref": "#/definitions/StoneColor" },
        "stones": {
          "type": "array",
          "items": { "$ref": "#/definitions/IntersectionCoord" }
        },
        "liberties": {
          "type": "array",
          "items": { "$ref": "#/definitions/IntersectionCoord" }
        }
      }
    },
    "BoardState": {
      "type": "object",
      "required": ["grid_size", "turn", "move_number", "captured_black", "captured_white"],
      "properties": {
        "grid_size": { "type": "integer", "enum": [10] },
        "turn": { "$ref": "#/definitions/StoneColor" },
        "move_number": { "type": "integer", "minimum": 0 },
        "captured_black": { "type": "integer", "minimum": 0 },
        "captured_white": { "type": "integer", "minimum": 0 },
        "ko_point": {
          "oneOf": [
            { "$ref": "#/definitions/IntersectionCoord" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
